<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Hargeisa Shoes - Online Shoe Shop</title>
  <style>
    /* Reset and base */
    * {
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      margin: 0; padding: 0;
      background-color: #f8f8f8;
      color: #333;
    }
    a {
      color: #0066cc;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }

    /* Header */
    header {
      background-color: #222;
      color: white;
      padding: 15px 20px;
      text-align: center;
    }
    header h1 {
      margin: 0;
      font-weight: normal;
      font-size: 28px;
      letter-spacing: 2px;
    }

    /* Navigation */
    nav {
      background-color: #444;
      display: flex;
      justify-content: center;
      gap: 20px;
      padding: 10px 0;
    }
    nav a {
      color: white;
      font-weight: bold;
      padding: 8px 15px;
      border-radius: 4px;
      transition: background-color 0.3s;
    }
    nav a:hover {
      background-color: #0066cc;
    }

    /* Main container */
    .container {
      max-width: 1100px;
      margin: 20px auto;
      padding: 0 15px;
    }

    /* Shoe products grid */
    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
    }
    .product {
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgb(0 0 0 / 0.1);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s;
    }
    .product:hover {
      transform: scale(1.05);
    }
    .product img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-bottom: 1px solid #ddd;
    }
    .product-info {
      padding: 15px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .product-info h3 {
      margin: 0 0 10px;
      font-size: 18px;
      color: #222;
    }
    .product-info p {
      margin: 0 0 15px;
      color: #555;
      font-size: 14px;
      flex-grow: 1;
    }
    .product-info .price {
      font-weight: bold;
      color: #0066cc;
      font-size: 16px;
    }

    /* Contact section */
    .contact {
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 2px 6px rgb(0 0 0 / 0.1);
      margin-top: 40px;
      text-align: center;
    }
    .contact h2 {
      margin-bottom: 15px;
      color: #222;
    }
    .contact p {
      font-size: 16px;
      margin: 8px 0;
      color: #555;
    }
    .contact .whatsapp-button {
      margin-top: 15px;
      display: inline-block;
      background-color: #25D366;
      color: white;
      padding: 12px 25px;
      font-weight: bold;
      border-radius: 5px;
      text-decoration: none;
      font-size: 18px;
      box-shadow: 0 3px 8px rgb(37 211 102 / 0.7);
      transition: background-color 0.3s;
    }
    .contact .whatsapp-button:hover {
      background-color: #1ebe57;
    }

    /* Footer */
    footer {
      background-color: #222;
      color: #aaa;
      text-align: center;
      padding: 12px 20px;
      margin-top: 40px;
      font-size: 14px;
    }

    /* Responsive typography */
    @media (max-width: 600px) {
      header h1 {
        font-size: 22px;
      }
      nav {
        flex-wrap: wrap;
        gap: 10px;
      }
      .product img {
        height: 150px;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>Hargeisa Shoes</h1>
  </header>

  <nav>
    <a href="#home">Home</a>
    <a href="#products">Shoes</a>
    <a href="#contact">Contact</a>
  </nav>

  <main class="container">
    <section id="home" style="margin-bottom:40px; text-align:center;">
      <h2>Welcome to Hargeisa Shoes!</h2>
      <p>Find quality shoes at great prices. We deliver in Hargeisa, Somaliland.</p>
    </section>

    <section id="products">
      <h2 style="margin-bottom:20px; text-align:center;">Our Shoes</h2>
      <div class="products">
        <div class="product">
          <img src="https://images.unsplash.com/photo-1519744792095-2f2205e87b6f?auto=format&fit=crop&w=400&q=80" alt="Running Shoe" />
          <div class="product-info">
            <h3>Running Shoe</h3>
            <p>Lightweight and comfortable for daily runs.</p>
            <div class="price">$35</div>
          </div>
        </div>
        <div class="product">
          <img src="https://images.unsplash.com/photo-1512499617640-c2f99912a516?auto=format&fit=crop&w=400&q=80" alt="Casual Sneaker" />
          <div class="product-info">
            <h3>Casual Sneaker</h3>
            <p>Perfect for everyday use and style.</p>
            <div class="price">$40</div>
          </div>
        </div>
        <div class="product">
          <img src="https://images.unsplash.com/photo-1528701800489-565f25e08a09?auto=format&fit=crop&w=400&q=80" alt="Leather Shoes" />
          <div class="product-info">
            <h3>Leather Shoes</h3>
            <p>Elegant and durable for special occasions.</p>
            <div class="price">$60</div>
          </div>
        </div>
        <div class="product">
          <img src="https://images.unsplash.com/photo-1574680096145-8f0d0f054f34?auto=format&fit=crop&w=400&q=80" alt="Sandals" />
          <div class="product-info">
            <h3>Comfort Sandals</h3>
            <p>Breathable and stylish for summer days.</p>
            <div class="price">$25</div>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="contact">
      <h2>Contact Us</h2>
      <p>WhatsApp: +252 63 1234567</p>
      <p>Payments accepted: Zaad, E-Dahab (No Visa or PayPal)</p>
      <a
        class="whatsapp-button"
        href="https://wa.me/252631234567"
        target="_blank"
        rel="noopener noreferrer"
      >
        Chat with us on WhatsApp
      </a>
    </section>
  </main>

  <footer>
    &copy; 2025 Hargeisa Shoes. All rights reserved. | Serving Hargeisa, Somaliland
  </footer>
</body>
</html>
